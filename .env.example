# Copy to .env and fill in what you have. NEVER commit .env.
# If Ollama is not running and no API key is set, the agent still runs with its
# deterministic planner/synthesizer. Use --offline for the synthetic demo corpus.

# --- LLM: the agent's "brain" (planning, re-planning, metric extraction, synthesis) ---

# Option A (recommended, free, private): local model via Ollama. No API key needed.
#   auto = use an installed Qwen model if there is one (else the first chat model).
#   Or pin an exact tag from `ollama list`, e.g. qwen2.5:7b / qwen3:8b / qwen2.5:14b.
#   Test it with: python main.py --check-llm
OLLAMA_MODEL=auto
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192             # context window; raise to 16384 if you have the RAM/VRAM
# LLM_TIMEOUT_S=300               # local models can be slow on CPU
# OLLAMA_THINK=false              # Qwen3 "thinking" off: much faster; set true to allow it

# Option B: hosted APIs (used only if OLLAMA_MODEL is empty, or LLM_PROVIDER is set)
# LLM_PROVIDER=ollama             # ollama | anthropic | openai | none (auto-detected if unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-5       # default: claude-sonnet-5 (anthropic) / gpt-4o-mini (openai)
# LLM_BASE_URL=                   # any OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1

# --- Web search ---
# Default search needs NO key or login: DuckDuckGo, then Bing web/news RSS as fallbacks.
# Optional: Tavily API key (used first when set).
TAVILY_API_KEY=
# SEARCH_PROVIDER=auto            # auto | bing | tavily | wikipedia
# AGENT_CONTACT=                  # email/URL for the User-Agent; only needed to enable Wikipedia

# --- Robustness knobs ---
# HTTP_TIMEOUT_S=10
# MAX_RETRIES=1
# RETRY_BACKOFF_S=0.5
# MAX_SOURCES=6
# MAX_PAGE_CHARS=8000
